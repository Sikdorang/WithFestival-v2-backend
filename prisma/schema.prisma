// Store = 기존 booth. 주문 그룹(Order) · 상세(OrderItem) · 대기(Waiting) · 메뉴(Menu)

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Store {
  id            Int    @id @default(autoincrement())
  name          String @db.VarChar(200)
  accountNumber String? @db.VarChar(100)
  notice        String? @db.Text
  event         String? @db.VarChar(500)
  reservationEnabled Boolean @default(false)
  /// 예약 시작 예정 시각 기준 5분 전 SMS(또는 발송 파이프) 안내 사용
  reservationRemindSms5MinBefore  Boolean @default(false)
  /// 예약 시작 예정 시각 기준 10분 전 SMS 안내 사용
  reservationRemindSms10MinBefore Boolean @default(false)
  missionsEnabled    Boolean @default(false)
  waitingsEnabled    Boolean @default(false)
  /// 기존 number 역할
  authCode      String @db.VarChar(64)

  createdAt DateTime @default(now())

  menus    Menu[]
  waitings Waiting[]
  orders   Order[]
  reservationSlots ReservationSlot[]
  missions Mission[]
  coupons Coupon[]
  tableLikes TableLike[]

  @@unique([authCode])
}

model Coupon {
  id            Int        @id @default(autoincrement())
  storeId       Int
  /// 부스별 유일 번호(trim 후 저장·조회)
  code          String     @db.VarChar(64)
  /// 할인 유형. AMOUNT=정액 할인(원), PERCENT=정률 할인(0~100)
  type          CouponType @default(AMOUNT)
  /// 할인 값. type이 AMOUNT면 원(₩) 단위 금액, PERCENT면 0~100 사이 정수
  discountPrice Int
  /// 사용 완료 여부(본 검증 API에서는 갱신하지 않음)
  used          Boolean    @default(false)
  /// 쿠폰을 받은 사람(이름·연락처 등 자유 텍스트, 없으면 null)
  holder        String?    @db.VarChar(200)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, code])
  @@index([storeId])
}

model Mission {
  id          Int      @id @default(autoincrement())
  storeId     Int
  missionName String   @db.VarChar(200)
  description String?  @db.Text
  reward      String   @db.VarChar(500)
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([storeId, isActive])
}

model Menu {
  id          Int     @id @default(autoincrement())
  storeId     Int
  name        String  @db.VarChar(200)
  price       Int
  /// 마진율(정수 %, 예: 15 = 15%)
  marginRate  Int     @default(0)
  /// 품절 여부(판매 가능 시 false)
  isSoldOut   Boolean @default(false)
  description String? @db.Text
  imageUrl    String? @db.VarChar(512)
  /// soft delete
  deleted     Boolean  @default(false)

  store      Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([storeId])
  @@index([storeId, deleted])
}

model Order {
  id         Int @id @default(autoincrement())
  storeId    Int
  /// 테이블(좌석) 식별자 — URL `tableId`와 동일하게 저장
  tableId    Int

  totalPrice Int
  /// RECEIVED: 접수됨 · COMPLETED: 처리 완료 · CANCELED: 취소
  status OrderStatus @default(RECEIVED)

  /// 결제 상태 (기존 `paymentCheck Boolean` 대신 enum으로 통일)
  paymentStatus PaymentStatus @default(PENDING)

  customerName String? @db.VarChar(200)
  phoneNumber  String? @db.VarChar(32)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items OrderItem[]

  @@index([storeId])
  @@index([storeId, tableId])
}

model OrderItem {
  id       Int @id @default(autoincrement())
  orderId  Int
  menuId   Int
  quantity Int
  /// 주문 시점 스냅샷 가격
  price    Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menu  Menu  @relation(fields: [menuId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([menuId])
}

model Log {
  id         Int      @id @default(autoincrement())
  identifier String   @db.VarChar(191)
  action     String   @db.VarChar(200)
  storeId    Int
  createdAt  DateTime @default(now())

  @@index([identifier])
  @@index([storeId])
  @@index([createdAt])
}

model TableLike {
  id        Int      @id @default(autoincrement())
  tokenUuid String   @db.VarChar(191)
  nickname  String   @db.VarChar(200)
  storeId   Int
  tableId   Int
  likeCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([tokenUuid])
  @@unique([storeId, tableId, nickname])
  @@index([storeId, tableId])
}

model Waiting {
  id          Int @id @default(autoincrement())
  storeId     Int
  name        String @db.VarChar(200)
  partySize   Int
  phoneNumber String? @db.VarChar(32)
  /// WAITING: 줄서기 대기 중 · ENTERED: 입장 처리됨 · CANCELED: 취소
  status      WaitingStatus @default(WAITING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

model ReservationSlot {
  id              Int      @id @default(autoincrement())
  storeId         Int
  startTime       String   @db.VarChar(32)
  endTime         String   @db.VarChar(32)
  availableTables Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  store        Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  @@index([storeId])
}

model Reservation {
  id                Int      @id @default(autoincrement())
  reservationSlotId Int
  reserverName      String   @db.VarChar(200)
  phoneNumber       String   @db.VarChar(32)
  partySize         Int
  deleted           Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  reservationSlot ReservationSlot @relation(fields: [reservationSlotId], references: [id], onDelete: Cascade)

  @@index([reservationSlotId])
  @@index([reservationSlotId, deleted])
}

/// 축제 단위 행사 정보(전역 메타데이터)
model Festival {
  id         String   @id @default(cuid()) @db.VarChar(191)
  university String   @db.VarChar(200)
  name       String   @db.VarChar(200)
  startDate  String   @db.VarChar(32)
  endDate    String   @db.VarChar(32)
  /// 개최 장소
  location   String   @db.VarChar(500)
}

enum OrderStatus {
  RECEIVED
  COMPLETED
  CANCELED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum WaitingStatus {
  WAITING
  ENTERED
  CANCELED
}

enum CouponType {
  /// 정액 할인 (원 단위, discountPrice가 차감 금액)
  AMOUNT
  /// 정률 할인 (0~100, discountPrice가 퍼센트 값)
  PERCENT
}
