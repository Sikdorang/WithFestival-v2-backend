// Store = 기존 booth. 주문 그룹(Order) · 상세(OrderItem) · 대기(Waiting) · 메뉴(Menu)

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model Store {
  id            Int    @id @default(autoincrement())
  name          String @db.VarChar(200)
  accountNumber String? @db.VarChar(100)
  notice        String? @db.Text
  /// 영어 공지(자동 번역, `notice` 저장 시 동시 갱신)
  noticeEn      String? @db.Text
  /// 중국어 공지(자동 번역, `notice` 저장 시 동시 갱신)
  noticeZh      String? @db.Text
  /// 일본어 공지(자동 번역, `notice` 저장 시 동시 갱신)
  noticeJa      String? @db.Text
  event         String? @db.VarChar(500)
  reservationEnabled Boolean @default(false)
  /// 예약 시작 예정 시각 기준 5분 전 SMS(또는 발송 파이프) 안내 사용
  reservationRemindSms5MinBefore  Boolean @default(false)
  /// 예약 시작 예정 시각 기준 10분 전 SMS 안내 사용
  reservationRemindSms10MinBefore Boolean @default(false)
  missionsEnabled    Boolean @default(false)
  waitingsEnabled    Boolean @default(false)
  /// 기존 number 역할
  authCode      String @db.VarChar(64)

  createdAt DateTime @default(now())

  menus    Menu[]
  waitings Waiting[]
  orders   Order[]
  reservationSlots ReservationSlot[]
  missions Mission[]
  coupons Coupon[]
  tableLikes TableLike[]

  @@unique([authCode])
}

model Coupon {
  id            Int        @id @default(autoincrement())
  storeId       Int
  /// 부스별 유일 번호(trim 후 저장·조회)
  code          String     @db.VarChar(64)
  /// 할인 유형. AMOUNT=정액 할인(원), PERCENT=정률 할인(0~100)
  type          CouponType @default(AMOUNT)
  /// 할인 값. type이 AMOUNT면 원(₩) 단위 금액, PERCENT면 0~100 사이 정수
  discountPrice Int
  /// 사용 완료 여부(본 검증 API에서는 갱신하지 않음)
  used          Boolean    @default(false)
  /// 쿠폰을 받은 사람(이름·연락처 등 자유 텍스트, 없으면 null)
  holder        String?    @db.VarChar(200)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, code])
  @@index([storeId])
}

model Mission {
  id          Int      @id @default(autoincrement())
  storeId     Int
  missionName String   @db.VarChar(200)
  description String?  @db.Text
  reward      String   @db.VarChar(500)
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@index([storeId, isActive])
}

model Menu {
  id          Int     @id @default(autoincrement())
  storeId     Int
  name        String  @db.VarChar(200)
  /// 영어 메뉴명(선택)
  nameEn      String? @db.VarChar(200)
  /// 중국어 메뉴명(선택)
  nameZh      String? @db.VarChar(200)
  /// 일본어 메뉴명(선택)
  nameJa      String? @db.VarChar(200)
  price       Int
  /// 마진율(정수 %, 예: 15 = 15%)
  marginRate  Int     @default(0)
  /// 품절 여부(판매 가능 시 false)
  isSoldOut   Boolean @default(false)
  description String? @db.Text
  /// 영어 설명(선택)
  descriptionEn String? @db.Text
  /// 중국어 설명(선택)
  descriptionZh String? @db.Text
  /// 일본어 설명(선택)
  descriptionJa String? @db.Text
  imageUrl    String? @db.VarChar(512)
  /// soft delete
  deleted     Boolean  @default(false)

  store      Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([storeId])
  @@index([storeId, deleted])
}

model Order {
  id         Int @id @default(autoincrement())
  storeId    Int
  /// 테이블(좌석) 식별자 — URL `tableId`와 동일하게 저장
  tableId    Int

  totalPrice Int
  /// RECEIVED: 접수됨 · COMPLETED: 처리 완료 · CANCELED: 취소
  status OrderStatus @default(RECEIVED)

  /// 결제 상태 (기존 `paymentCheck Boolean` 대신 enum으로 통일)
  paymentStatus PaymentStatus @default(PENDING)

  customerName String? @db.VarChar(200)
  phoneNumber  String? @db.VarChar(32)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items OrderItem[]

  @@index([storeId])
  @@index([storeId, tableId])
}

model OrderItem {
  id       Int @id @default(autoincrement())
  orderId  Int
  menuId   Int
  quantity Int
  /// 주문 시점 스냅샷 가격
  price    Int
  /// 품목 단위 완료 처리 여부(부스 staff가 체크)
  completed Boolean @default(false)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menu  Menu  @relation(fields: [menuId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([menuId])
}

model Log {
  id         Int      @id @default(autoincrement())
  identifier String   @db.VarChar(191)
  action     String   @db.VarChar(200)
  storeId    Int
  createdAt  DateTime @default(now())

  @@index([identifier])
  @@index([storeId])
  @@index([createdAt])
}

model TableLike {
  id        Int      @id @default(autoincrement())
  tokenUuid String   @db.VarChar(191)
  nickname  String   @db.VarChar(200)
  storeId   Int
  tableId   Int
  likeCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([tokenUuid])
  @@unique([storeId, tableId, nickname])
  @@index([storeId, tableId])
}

model Waiting {
  id          Int @id @default(autoincrement())
  storeId     Int
  name        String @db.VarChar(200)
  partySize   Int
  phoneNumber String? @db.VarChar(32)
  /// WAITING: 줄서기 대기 중 · ENTERED: 입장 처리됨 · CANCELED: 취소
  status      WaitingStatus @default(WAITING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
}

model ReservationSlot {
  id              Int      @id @default(autoincrement())
  storeId         Int
  startTime       String   @db.VarChar(32)
  endTime         String   @db.VarChar(32)
  availableTables Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  store        Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  @@index([storeId])
}

model Reservation {
  id                Int      @id @default(autoincrement())
  reservationSlotId Int
  reserverName      String   @db.VarChar(200)
  phoneNumber       String   @db.VarChar(32)
  partySize         Int
  deleted           Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  reservationSlot ReservationSlot @relation(fields: [reservationSlotId], references: [id], onDelete: Cascade)

  @@index([reservationSlotId])
  @@index([reservationSlotId, deleted])
}

/// 축제 단위 행사 정보(전역 메타데이터)
model Festival {
  id         String   @id @default(cuid()) @db.VarChar(191)
  university String   @db.VarChar(200)
  name       String   @db.VarChar(200)
  startDate  String   @db.VarChar(32)
  endDate    String   @db.VarChar(32)
  /// 개최 장소
  location   String   @db.VarChar(500)
}

enum OrderStatus {
  RECEIVED
  COMPLETED
  CANCELED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum WaitingStatus {
  WAITING
  ENTERED
  CANCELED
}

enum CouponType {
  /// 정액 할인 (원 단위, discountPrice가 차감 금액)
  AMOUNT
  /// 정률 할인 (0~100, discountPrice가 퍼센트 값)
  PERCENT
}

enum Gender {
  /// 남
  MALE
  /// 녀
  FEMALE
}

/// 소개팅 명단(축제 등 운영자가 매칭용으로 모으는 응모자 목록).
/// 본인 정보(이름·나이·연락처·MBTI·외모 스타일·성별)와 매칭 시 상대 번호를
/// 전달받을 휴대폰 번호(`deliveryPhone`)를 함께 저장합니다.
model BlindDate {
  id              Int      @id @default(autoincrement())
  /// 본인 이름
  name            String   @db.VarChar(100)
  /// 나이
  age             Int
  /// 연락처(인스타/카톡 ID 등 자유 텍스트)
  contact         String   @db.VarChar(200)
  /// MBTI 16유형 (예: ENFP)
  mbti            String   @db.VarChar(8)
  /// 외모 스타일 코드(운영자가 정의한 정수값, 예: 1~5)
  appearanceStyle Int
  /// 성별
  gender          Gender
  /// 본인에게 매칭 상대 번호를 이미 전달했는지 여부(운영자 표시용)
  numberDelivered Boolean  @default(false)
  /// 매칭 시 상대 번호를 받을 본인 휴대폰 번호
  deliveryPhone   String   @db.VarChar(32)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([gender, numberDelivered])
  @@index([createdAt])
}
