# Host Prisma/Nest -> Podman MySQL (compose maps 13306:3306)
DATABASE_URL="mysql://withfestival:withfestival@127.0.0.1:13306/withfestival"
JWT_SECRET="change-me-in-production"

# Swagger UI Basic Auth password. 미설정 시 Swagger는 인증 없이 누구나 열람 가능합니다.
# 값이 있으면 /api/docs, /api/docs-json, /api/docs-yaml 모두 Basic Auth로 보호됩니다.
SWAGGER_PASSWORD=

# Menu image upload (S3). 프로젝트 루트 .env 에만 두고 커밋하지 말 것.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
S3_BUCKET=

# Google Cloud Translation API (메뉴 자동 번역). 미설정 시 번역 필드는 null로 저장됩니다.
GOOGLE_TRANSLATE_API_KEY=
